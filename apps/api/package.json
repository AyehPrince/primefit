{
  "name": "@primefit/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json src/server.ts",
    "build": "tsup src/server.ts --format esm --dts",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/helmet": "latest",
    "@fastify/jwt": "latest",
    "@fastify/rate-limit": "latest",
    "@primefit/db": "workspace:*",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "latest",
    "fastify": "latest",
    "fastify-plugin": "latest",
    "node-cron": "^4.2.1",
    "pg": "latest",
    "pino-pretty": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "latest",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}