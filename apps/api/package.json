{
  "name": "@primefit/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.json src/server.ts",
    "build": "prisma generate && tsup src/server.ts --format cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/helmet": "latest",
    "@fastify/jwt": "latest",
    "@fastify/rate-limit": "latest",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "bcryptjs": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "fastify-plugin": "latest",
    "node-cron": "latest",
    "pg": "latest",
    "pino-pretty": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/node": "latest",
    "@types/node-cron": "latest",
    "@types/pg": "latest",
    "prisma": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}